<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Optional -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Camera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- ===== ADDED: USB host feature for the UVC webcam. required="false" so
         devices without USB host support (or without a webcam plugged in)
         still install fine; LiveViewService already no-ops gracefully when
         no USB camera is attached. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="B-link"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:banner="@mipmap/ic_launcher"
        tools:ignore="MissingTvBanner">

        <!-- ================================================= -->
        <!-- MAIN ACTIVITY / HOME / LAUNCHER                   -->
        <!-- ================================================= -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">

            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- ADDED: declares this app as the handler for UVC webcam attach
                 events. Since no other app on the box claims this, Android grants
                 USB permission silently — no "Allow B-link to access..." dialog,
                 ever, on this or future boots. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />

        </activity>

        <!-- ================================================= -->
        <!-- BOOT RECEIVER                                     -->
        <!-- ================================================= -->
        <receiver
            android:name=".SignageBootReceiver"
            android:enabled="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>

        </receiver>

        <!-- ================================================= -->
        <!-- BOOT LAUNCH SERVICE                               -->
        <!-- ================================================= -->
        <service
            android:name=".BootLaunchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="signage kiosk auto-launch after boot" />

        </service>

        <service
            android:name=".LiveViewService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <receiver
            android:name=".SignageDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">

            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>

        </receiver>

    </application>

</manifest>